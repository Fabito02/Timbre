using Gtk 4.0;
using Adw 1;

template $TimbreSearchPage: Box {
  orientation: vertical;
  vexpand: true;

  Adw.ViewStack stack {
    vexpand: true;

    Adw.ViewStackPage {
      name: "main";

      child: Adw.StatusPage main_page {
        icon-name: "system-search-symbolic";
        title: _("Search");
        description: _("Enter the name of a song, album, or artist.");
      };
    }

    Adw.ViewStackPage {
      name: "loading";

      child: Box {
        orientation: vertical;
        valign: center;
        halign: center;
        spacing: 12;

        Adw.Spinner {
          width-request: 32;
          height-request: 32;
        }

        Label {
          label: _("Searching...");

          styles [
            "dim-label",
          ]
        }
      };
    }

    Adw.ViewStackPage {
      name: "empty";

      child: Adw.StatusPage status_page {
        icon-name: "edit-find-symbolic";
        title: _("No results");
        description: _("Try searching for another term.");
      };
    }

    Adw.ViewStackPage {
      name: "results";

      child: Box {
        orientation: vertical;
        vexpand: true;

        ScrolledWindow toggle_scroll {
          hscrollbar-policy: external;
          vscrollbar-policy: never;
          margin-top: 12;
          margin-bottom: 6;

          Viewport {
            hscroll-policy: natural;

            Box toggle_container {
              orientation: horizontal;
              halign: center;
              margin-start: 12;
              margin-end: 12;
            }
          }
        }

        ScrolledWindow results_scroll {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          vexpand: true;

          Adw.Clamp {
            maximum-size: 920;
            tightening-threshold: 512;

            Stack results_stack {
              transition-type: crossfade;
              vhomogeneous: false;
              hhomogeneous: false;
              valign: start;
            }
          }
        }
      };
    }
  }
}
