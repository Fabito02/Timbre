using Gtk 4.0;

template $TimbreTrackRow: ListBoxRow {
  activatable: true;

  Box {
    orientation: horizontal;
    spacing: 6;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;

    Overlay {
      Box {
        width-request: 48;
        height-request: 48;
      }

      [overlay]
      Picture image_cover {
        can-shrink: true;
        content-fit: contain;
        halign: fill;
        valign: fill;

        styles [
          "row-cover-img",
        ]
      }
    }

    Box {
      orientation: vertical;
      spacing: 2;
      hexpand: true;
      valign: center;

      Box {
        orientation: horizontal;
        
        Label label_title {
          xalign: 0.0;
          ellipsize: end;
  
          styles [
            "heading",
          ]
        }
  
        Label explicit_badge {
          label: "E";
          valign: center;
          margin-start: 6;
  
          styles [
            "explicit-badge",
          ]
        }
      }

      Label label_artist {
        xalign: 0.0;
        ellipsize: end;

        styles [
          "caption",
          "dim-label",
        ]
      }
    }

    Box live_badge {
      orientation: horizontal;
      halign: end;
      valign: center;

      styles [
        "live-overlay",
      ]

      Image {
        icon-name: "radio-wave-symbolic";
        pixel-size: 14;
        margin-end: 4;

        styles [
          "live-overlay-icon",
        ]
      }
      Label {
        label: _("Live");
      }
    }

    Label label_duration {
      valign: center;

      styles [
        "numeric",
        "caption",
        "dim-label",
      ]
    }

    Box like_slot {
      orientation: horizontal;
      spacing: 0;
      valign: center;
      halign: end;
    }
  }
}
