using Gtk 4.0;
using Adw 1;

template $TimbreTrackCard: Button {
  styles [
    "card-btn",
    "flat",
  ]

  Box {
    orientation: vertical;
    spacing: 12;

    Adw.Bin {
      Overlay {
        Picture image_cover {
          can-shrink: true;
          content-fit: cover;
          valign: center;
          halign: center;

          styles [
            "card-cover-img",
          ]
        }

        [overlay]
        Adw.Bin play_overlay {
          halign: center;
          valign: center;

          styles [
            "play-overlay",
          ]

          Image {
            icon-name: "media-playback-start-symbolic";
            pixel-size: 22;

            styles [
              "play-overlay-icon",
            ]
          }
        }

        [overlay]
        Adw.Bin album_overlay {
          halign: end;
          valign: end;

          styles [
            "album-overlay",
          ]

          Image {
            icon-name: "media-optical-symbolic";
            pixel-size: 18;

            styles [
              "album-overlay-icon",
            ]
          }
        }

        [overlay]
        Box live_overlay {
          orientation: horizontal;
          halign: end;
          valign: end;

          styles [
            "live-overlay",
          ]

          Image {
            icon-name: "radio-wave-symbolic";
            pixel-size: 14;
            margin-end: 4;

            styles [
              "live-overlay-icon",
            ]
          }
          Label {
            label: _("Live");
          }
        }
      }
    }

    Box {
      orientation: vertical;
      spacing: 2;
      valign: center;

      Box {
        orientation: horizontal;
        spacing: 6;
        
        Label label_title {
          xalign: 0.0;
          ellipsize: end;
  
          styles [
            "heading",
          ]
        }
        
        Label explicit_badge {
            label: "E";
            valign: center;
            styles ["explicit-badge"]
        }
      }

      Label label_artist {
        xalign: 0.0;
        ellipsize: end;

        styles [
          "caption",
          "dim-label",
        ]
      }
    }
  }
}
