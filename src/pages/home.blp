using Gtk 4.0;
using Adw 1;

template $TimbreHomePage: Adw.NavigationPage {
  Gtk.Stack stack {
    transition-type: crossfade;
    vexpand: true;
    hhomogeneous: false;
    visible-child-name: "loading";

    Gtk.StackPage {
      name: "loading";

      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        vexpand: true;

        Adw.Clamp {
          maximum-size: 1080;
          tightening-threshold: 720;

          Gtk.Box skeleton_box {
            orientation: vertical;
            spacing: 32;
            margin-top: 32;
            margin-bottom: 32;
            margin-start: 18;
            margin-end: 18;
            valign: center;
            vexpand: true;
          }
        }
      };
    }

    Gtk.StackPage {
      name: "feed";

      child: Gtk.ScrolledWindow feed_scroll {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        vexpand: true;

        Adw.Clamp {
          maximum-size: 1080;
          tightening-threshold: 720;

          Gtk.Box content_box {
            orientation: vertical;
            spacing: 32;
            margin-top: 32;
            margin-bottom: 32;
            margin-start: 18;
            margin-end: 18;
          }
        }
      };
    }

    Gtk.StackPage {
      name: "status";

      child: Adw.StatusPage status_page {
        icon-name: "user-home-symbolic";
        title: _("Could not load Home");
        description: _("Try refreshing in a moment.");
      };
    }
  }
}
