using Gtk 4.0;
using Adw 1;

template $TimbreHomePage : Adw.NavigationPage {
  ScrolledWindow {
    hscrollbar-policy: never;

    Adw.Clamp {
      maximum-size: 1280;

      Box content_box {
        orientation: vertical;
        spacing: 24;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 8;
        margin-end: 8;

      }
    }
  }
}

