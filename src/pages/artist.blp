using Gtk 4.0;
using Adw 1;

template $TimbreArtistPage: Adw.NavigationPage {
  title: _("Artist");

  child: Overlay page_overlay {
    Adw.ViewStack stack {
      vexpand: true;

      Adw.ViewStackPage {
        name: "loading";

        child: Adw.Bin {
          valign: center;
          halign: center;

          Adw.Spinner {
            width-request: 32;
            height-request: 32;
          }
        };
      }

      Adw.ViewStackPage {
        name: "content";

        child: ScrolledWindow scroll {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          vexpand: true;

          Box page_box {
            orientation: vertical;

            Overlay header_overlay {
              hexpand: true;
              height-request: 460;

              $TimbreBannerFadeWrapper banner_fade_wrapper {
                hexpand: true;
                vexpand: true;
                halign: fill;
                valign: fill;

                Picture banner_picture {
                  content-fit: cover;
                  can-shrink: true;
                  hexpand: true;
                  vexpand: true;
                  halign: fill;
                  valign: fill;
                }
              }

              [overlay]
              Box banner_scrim {
                hexpand: true;
                vexpand: true;

                styles [
                  "banner-scrim",
                ]
              }

              [overlay]
              Adw.Clamp header_clamp {
                maximum-size: 1080;
                tightening-threshold: 720;
                valign: end;

                Box info_box {
                  orientation: vertical;
                  spacing: 4;
                  margin-bottom: 16;
                  margin-start: 16;
                  margin-end: 16;

                  Label label_name {
                    halign: start;
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;

                    styles [
                      "title-bigger",
                    ]
                  }

                  Label label_info {
                    halign: start;

                    styles [
                      "dim-label",
                    ]
                  }

                  Box actions {
                    orientation: horizontal;
                    spacing: 12;
                    margin-top: 8;
                    valign: center;

                    Button button_play {
                      tooltip-text: _("Play");

                      child: Box {
                        Image {
                          icon-name: "media-playback-start-symbolic";
                          pixel-size: 16;
                          margin-end: 8;
                        }

                        Label {
                          label: _("Play");
                        }
                      };

                      styles [
                        "suggested-action",
                        "pill",
                      ]
                    }

                    Button button_shuffle {
                      icon-name: "media-playlist-shuffle-symbolic";
                      tooltip-text: _("Shuffle");
                      width-request: 44;

                      styles [
                        "circular",
                      ]
                    }

                    Button button_radio {
                      icon-name: "radio-wave-symbolic";
                      tooltip-text: _("Start Radio");
                      width-request: 44;

                      styles [
                        "circular",
                      ]
                    }

                    Button button_subscribe {
                      child: Box {
                        Image button_subscribe_image {
                          icon-name: "non-starred-symbolic";
                          pixel-size: 16;
                          margin-end: 8;
                        }

                        Label button_subscribe_label {
                          label: _("Subscribe - ");
                        }

                        Label label_subscribers {}
                      };

                      tooltip-text: _("Subscribe");

                      styles [
                        "pill",
                        "add-button",
                      ]
                    }
                  }
                }
              }
            }

            Adw.Clamp {
              maximum-size: 1080;
              tightening-threshold: 720;

              Box content_box {
                orientation: vertical;
                margin-bottom: 32;
                margin-start: 16;
                margin-end: 16;

                Box description_box {
                  orientation: vertical;
                  spacing: 4;
                  margin-bottom: 24;

                  Label label_description {
                    halign: start;
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;

                    styles [
                      "body",
                    ]
                  }

                  Label label_read_more {
                    halign: start;
                    use-markup: true;

                    styles [
                      "caption",
                    ]
                  }
                }

                Box sections_box {
                  orientation: vertical;
                  spacing: 32;
                  margin-top: 8;
                }
              }
            }
          }
        };
      }
    }

    [overlay]
    Adw.HeaderBar header_bar {
      valign: start;
      show-back-button: false;

      styles [
        "flat",
      ]

      [start]
      Button button_back_custom {
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Back");
        action-name: "navigation.pop";
      }
    }
  };
}
