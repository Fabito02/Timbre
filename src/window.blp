using Gtk 4.0;
using Adw 1;

template $TimbreWindow : Adw.ApplicationWindow {
  default-width: 800;
  default-height: 600;
  title: "Timbre";

  content: Box {
    orientation: vertical;

    Adw.HeaderBar {
      [title]
      Adw.WindowTitle {
        title: "Timbre";
        subtitle: "Music Player";
      }
    }

    Box {
      vexpand: true;
      hexpand: true;
      halign: center;
      valign: center;

      Label {
        label: "Nenhuma música selecionada";
        styles ["title-2"]
      }
    }

    Box {
      orientation: vertical;
      spacing: 6;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 18;
      margin-end: 18;
      styles ["toolbar"]

      Scale scale_progress {
        hexpand: true;
        orientation: horizontal;
        value-changed => $on_seek_changed();
        adjustment: Adjustment adjustment_progress {
          lower: 0.0;
          upper: 0.0;
          step-increment: 1.0;
        };
      }

      CenterBox {
        [start]
        Label label_time_current {
          label: "0:00";
          styles ["numeric", "caption"]
        }

        [center]
        Box {
          spacing: 12;
          halign: center;

          Button button_play_pause {
            icon-name: "media-playback-start-symbolic";
            styles ["suggested-action", "circular"]
            clicked => $on_play_pause_clicked();
          }
        }

        [end]
        Label label_time_total {
          label: "0:00";
          styles ["numeric", "caption"]
        }
      }
    }
  };
}
